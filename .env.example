# Resend — waitlist signups
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# The Audience to push waitlist signups into.
# Create at https://resend.com/audiences and copy the Audience ID.
RESEND_AUDIENCE_ID=

# Google Maps Platform API key
# Used for: Geocoding (coordinate population), Places (venue seeding),
# Distance Matrix + Directions (Planner sprint).
# Get one at: https://console.cloud.google.com/google/maps-apis
# Restrict to: Geocoding, Places, Distance Matrix, Directions APIs only.
GOOGLE_MAPS_API_KEY=
