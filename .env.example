# Resend — waitlist signups
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# The Audience to push waitlist signups into.
# Create at https://resend.com/audiences and copy the Audience ID.
RESEND_AUDIENCE_ID=

# Google Maps Platform API key
# Used for: Geocoding (coordinate population via scripts/geocode-south-coast.mjs),
# Places (venue seeding), Distance Matrix + Directions (Planner sprint).
# Get one at: https://console.cloud.google.com/google/maps-apis
# Restrict to: Geocoding, Places, Distance Matrix, Directions APIs only.
GOOGLE_MAPS_API_KEY=

# Mapbox public token (pk.* prefix) — client-side, restricted on the Mapbox dashboard.
# URL allow-list: localhost (dev), vibelanka.com (prod). Restrict in dashboard, not via env var secrecy.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Supabase (Track 2) — values in password manager: "Vibe Lanka — Supabase"
# Project ref vvmrqrtzasitgrkpafzj (vibelankaa@gmail.com account).
# Local dev: copy these into .env.local (gitignored) with the real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
